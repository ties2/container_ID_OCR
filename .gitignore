# ==========================================
# 1. Data: images and generated files stay local.
#    Only small, hand-made files are versioned:
#    annotations, typed codes, split table, selection sheets.
# ==========================================
data/01_raw/*
!data/01_raw/.gitkeep

data/02_interim/*
!data/02_interim/.gitkeep
!data/02_interim/labels.csv
!data/02_interim/split_assignments.csv
# CVAT exports (one folder per task): only the annotations.xml files are versioned
!data/02_interim/cvat_export/
data/02_interim/cvat_export/**
!data/02_interim/cvat_export/**/
!data/02_interim/cvat_export/**/annotations.xml

data/03_processed/*
!data/03_processed/.gitkeep

# data/metadata/ (Label-camera-*.csv, images-camera-info.csv) is versioned.

# ==========================================
# 2. Models, weights, logs, results
# ==========================================
models/*
!models/.gitkeep
*.pt
*.pth
*.onnx
runs/

logs/*
!logs/.gitkeep

# results: only the text summaries of the runs are versioned
results/*
!results/.gitkeep
!results/history/
results/history/*
!results/history/*.txt

# ==========================================
# 3. Python & tooling
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ==========================================
# 4. Environments, OS, IDE
# ==========================================
.venv/
venv/
env/
ENV/
.conda/
.local/
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.idea/
.vscode/
*.swp
*.swo
